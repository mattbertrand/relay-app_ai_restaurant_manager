{
  "name": "Action",
  "type": "object",
  "properties": {
    "restaurant_id": {
      "type": "string"
    },
    "opportunity_id": {
      "type": "string"
    },
    "conversation_id": {
      "type": "string",
      "description": "The conversation (email thread) this action belongs to, when the action is tied to a specific message."
    },
    "type": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "requires_approval": {
      "type": "boolean",
      "default": true
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "When this follow-up is due, when the manager stated a date in their response. Empty means the follow-up still needs scheduling \u2014 never an invented date."
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "restaurant_id",
    "type",
    "status"
  ],
  "rls": {
    "read": {
      "data.restaurant_id": "{{user.data.restaurant_id}}"
    },
    "create": {
      "data.restaurant_id": "{{user.data.restaurant_id}}"
    },
    "update": {
      "data.restaurant_id": "{{user.data.restaurant_id}}"
    },
    "delete": {
      "data.restaurant_id": "{{user.data.restaurant_id}}"
    }
  }
}