{
  "name": "Opportunity",
  "type": "object",
  "properties": {
    "restaurant_id": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "estimated_value_min": {
      "type": "number"
    },
    "estimated_value_max": {
      "type": "number"
    },
    "value_confidence": {
      "type": "string",
      "enum": [
        "High",
        "Medium",
        "Low"
      ]
    },
    "value_basis": {
      "type": "string",
      "description": "Short explanation of how the potential value was estimated, e.g. 'Estimate based on 80 guests x $18-$30 per person.'"
    },
    "priority": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "draft_status": {
      "type": "string",
      "enum": [
        "Draft",
        "Edited",
        "Approved"
      ]
    },
    "dismiss_reason": {
      "type": "string"
    },
    "recommended_action": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "original_message": {
      "type": "string"
    },
    "why_identified": {
      "type": "string"
    },
    "last_analyzed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this opportunity's analysis was last generated \u2014 used to detect that Restaurant Knowledge changed since the analysis."
    },
    "previous_analysis": {
      "type": "string",
      "description": "Snapshot of the analysis as it stood before the last re-analysis (classification, reasoning, draft) \u2014 preserved for audit so nothing is silently overwritten."
    },
    "draft_response": {
      "type": "string"
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "restaurant_id",
    "type",
    "title",
    "status"
  ],
  "rls": {
    "read": {
      "data.restaurant_id": "{{user.data.restaurant_id}}"
    },
    "create": {
      "data.restaurant_id": "{{user.data.restaurant_id}}"
    },
    "update": {
      "data.restaurant_id": "{{user.data.restaurant_id}}"
    },
    "delete": {
      "data.restaurant_id": "{{user.data.restaurant_id}}"
    }
  }
}