{
  "name": "Customer",
  "type": "object",
  "properties": {
    "restaurant_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "first_seen": {
      "type": "string",
      "format": "date-time"
    },
    "last_contact": {
      "type": "string",
      "format": "date-time"
    },
    "conversation_count": {
      "type": "integer",
      "default": 0
    }
  },
  "required": [
    "restaurant_id",
    "email"
  ],
  "rls": {
    "read": {
      "data.restaurant_id": "{{user.data.restaurant_id}}"
    },
    "create": {
      "data.restaurant_id": "{{user.data.restaurant_id}}"
    },
    "update": {
      "data.restaurant_id": "{{user.data.restaurant_id}}"
    },
    "delete": {
      "data.restaurant_id": "{{user.data.restaurant_id}}"
    }
  }
}