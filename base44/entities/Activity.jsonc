{
  "name": "Activity",
  "type": "object",
  "properties": {
    "restaurant_id": {
      "type": "string"
    },
    "opportunity_id": {
      "type": "string"
    },
    "conversation_id": {
      "type": "string",
      "description": "The conversation (email thread) this event belongs to, when the event is about a specific message. Together with opportunity_id this makes every history event unambiguously scoped: an opportunity's history shows only events with its own opportunity_id or the conversation_id of its own linked conversation."
    },
    "action_id": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "restaurant_id",
    "type",
    "description"
  ],
  "rls": {
    "read": {
      "data.restaurant_id": "{{user.data.restaurant_id}}"
    },
    "create": {
      "data.restaurant_id": "{{user.data.restaurant_id}}"
    },
    "update": {
      "data.restaurant_id": "{{user.data.restaurant_id}}"
    },
    "delete": {
      "data.restaurant_id": "{{user.data.restaurant_id}}"
    }
  }
}