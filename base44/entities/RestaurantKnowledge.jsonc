{
  "name": "RestaurantKnowledge",
  "type": "object",
  "description": "The restaurant's Restaurant Profile \u2014 verified information the manager entered (customer-facing knowledge plus HR, vendors, finance, operations, and marketing context). Relay uses only what is entered here; it never invents facts.",
  "properties": {
    "restaurant_id": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "zip": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "timezone": {
      "type": "string",
      "description": "The restaurant's local timezone as an IANA name (e.g. 'America/Los_Angeles'). All user-facing timestamps are displayed in this timezone; stored timestamps remain UTC."
    },
    "email_signature": {
      "type": "string",
      "description": "Plain-text version of the manager's default email signature (kept in sync with signature_text)."
    },
    "signature_html": {
      "type": "string",
      "description": "The manager's rich email signature as sanitized HTML \u2014 the primary version for rendering email drafts and future HTML email sending. Never flattened back to plain text."
    },
    "signature_text": {
      "type": "string",
      "description": "Plain-text fallback of the manager's rich email signature, for plain-text consumers and signature deduplication."
    },
    "review_signature": {
      "type": "string",
      "description": "The manager's separate, shorter public signature for review responses \u2014 intentionally distinct from the email signature because review platforms are public."
    },
    "hours": {
      "type": "object",
      "additionalProperties": true,
      "description": "Weekly operating hours keyed by day name, e.g. { Monday: { open: '11:00', close: '21:00', closed: false } }."
    },
    "temporary_hours": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "label": {
            "type": "string"
          },
          "start_date": {
            "type": "string"
          },
          "end_date": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      },
      "description": "One-time holiday closures, holiday hours, temporary closures, and special event hours with optional start/end dates. On a date covered by a one-time entry, the one-time entry takes precedence over any recurring special hours rule."
    },
    "recurring_special_hours": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "label": {
            "type": "string"
          },
          "frequency": {
            "type": "string",
            "enum": [
              "weekly"
            ],
            "description": "Recurrence frequency. Weekly only for now."
          },
          "day_of_week": {
            "type": "string",
            "description": "The weekday the rule applies to, e.g. 'Monday'."
          },
          "start_time": {
            "type": "string"
          },
          "end_time": {
            "type": "string"
          },
          "effective_start_date": {
            "type": "string",
            "description": "The date the rule becomes active (YYYY-MM-DD), in the restaurant's local timezone."
          },
          "end_date": {
            "type": "string",
            "description": "Optional date after which the rule no longer applies (YYYY-MM-DD)."
          },
          "exceptions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "date": {
                  "type": "string",
                  "description": "The skipped occurrence's date (YYYY-MM-DD)."
                },
                "note": {
                  "type": "string",
                  "description": "Why this occurrence is skipped, e.g. 'Private event'."
                }
              }
            },
            "description": "Individual occurrence dates the rule is skipped on. Skipping one occurrence never disables the rule \u2014 it continues on subsequent weeks."
          }
        }
      },
      "description": "Recurring special hours stored as recurrence rules (e.g. Trivia every Monday 6\u201310 PM) with per-date exceptions. Occurrences are computed when needed \u2014 never materialized as individual records. A one-time special hours entry on the same date takes precedence over the rule."
    },
    "reservations": {
      "type": "object",
      "additionalProperties": true,
      "description": "Reservation rules: accepted, method, phone, email, website, max_party_size, max_party_without_approval, large_party_policy, cancellation_policy, no_show_policy, deposit_policy, time_restrictions, other_rules."
    },
    "private_events": {
      "type": "object",
      "additionalProperties": true,
      "description": "Private event details: offered, min_capacity, max_capacity, event_types, private_dining_options, policies, booking_process, contact, pricing."
    },
    "catering": {
      "type": "object",
      "additionalProperties": true,
      "description": "Catering details: offered, types, min_guests, max_guests, service_area, policies, booking_process, contact, pricing."
    },
    "happy_hour": {
      "type": "object",
      "additionalProperties": true,
      "description": "Happy hour details: offered, days, start_time, end_time, details."
    },
    "recurring_offerings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "name": {
            "type": "string"
          },
          "days": {
            "type": "string"
          },
          "time": {
            "type": "string"
          },
          "details": {
            "type": "string"
          }
        }
      },
      "description": "Recurring offerings such as brunch, live music, taco night, trivia, seasonal events."
    },
    "menu": {
      "type": "object",
      "additionalProperties": true,
      "description": "Menu and offerings: summary, vegetarian, vegan, gluten_free, allergens, kids_menu, takeout, delivery, gift_cards, loyalty_program, dietary_accommodations."
    },
    "policies": {
      "type": "object",
      "additionalProperties": true,
      "description": "Policies and FAQ answers: dress_code, pet_policy, parking, accessibility, outside_food_drinks, birthday_policy, cake_policy, decorations, age_restrictions, other."
    },
    "other_info": {
      "type": "string",
      "description": "Other verified information Relay should know about this restaurant."
    },
    "response_templates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "name": {
            "type": "string"
          },
          "inquiry_category": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "when_to_use": {
            "type": "string"
          },
          "response_guidance": {
            "type": "string"
          },
          "info_to_collect": {
            "type": "string"
          },
          "recommended_next_action": {
            "type": "string"
          },
          "handoff_to": {
            "type": "string"
          },
          "handoff_contact": {
            "type": "string"
          },
          "active": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "description": "Restaurant-specific response templates for common inquiries (e.g. Dine & Donate requests, private events, ADA seating, catering, sponsorship). Guidance for Relay's analysis, recommended next action, and draft generation \u2014 never automatic sending or forwarding."
    },
    "review_policy": {
      "type": "object",
      "additionalProperties": true,
      "description": "Optional restaurant-specific review attention/response policy (e.g. Google: manager attention for 1\u20132 star reviews, positive reviews informational; Yelp: monitor only). Foundation for restaurant-specific review handling \u2014 the Review Source architecture stays provider-agnostic and Relay never assumes every review needs a response."
    },
    "hr": {
      "type": "object",
      "additionalProperties": true,
      "description": "HR and employment context: hiring (bool), positions_hiring, application_instructions, application_email, application_method, interview_process, hiring_contact, employee_inquiry_contact, hr_notes. Used to understand job-related communications \u2014 never as customer opportunity content."
    },
    "vendors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "contact_name": {
            "type": "string"
          },
          "contact_email": {
            "type": "string"
          },
          "contact_phone": {
            "type": "string"
          },
          "products_services": {
            "type": "string"
          },
          "ordering_instructions": {
            "type": "string"
          },
          "delivery_schedule": {
            "type": "string"
          },
          "ordering_cutoff": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "escalation_contact": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "description": "Known vendors and suppliers. Lets Relay recognize communication from a vendor the restaurant already works with (matched by contact email or name) versus unknown cold outreach."
    },
    "finance": {
      "type": "object",
      "additionalProperties": true,
      "description": "Finance and billing context: accounting_contact, invoice_contact, invoice_submission_procedure, payment_procedure, payment_approval_requirements, payment_deadlines, billing_email, finance_notes. Trusted context only \u2014 Relay is not an accounting system."
    },
    "operations": {
      "type": "object",
      "additionalProperties": true,
      "description": "Operations context: opening_procedures, closing_procedures, manager_responsibilities, recurring_duties, maintenance_contacts, equipment_contacts, cleaning_procedures, emergency_contacts, operational_policies, operations_notes."
    },
    "marketing": {
      "type": "object",
      "additionalProperties": true,
      "description": "Marketing context: social_media, marketing_contact, current_promotions, recurring_promotions, brand_guidelines, marketing_notes."
    }
  },
  "required": [
    "restaurant_id"
  ],
  "rls": {
    "read": {
      "data.restaurant_id": "{{user.data.restaurant_id}}"
    },
    "create": {
      "data.restaurant_id": "{{user.data.restaurant_id}}"
    },
    "update": {
      "data.restaurant_id": "{{user.data.restaurant_id}}"
    },
    "delete": {
      "data.restaurant_id": "{{user.data.restaurant_id}}"
    }
  }
}