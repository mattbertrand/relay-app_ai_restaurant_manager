{
  "name": "Restaurant",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "owner_id": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "restaurant_type": {
      "type": "string"
    },
    "employee_count": {
      "type": "string"
    },
    "monthly_inquiries": {
      "type": "string"
    },
    "gmail_setup": {
      "type": "object",
      "additionalProperties": true,
      "description": "This restaurant's Gmail connection setup: the initial email history choice (window: 'now' | '7d' | '30d' | 'custom', from_date for custom), when it was selected, and when the initial history import completed. Controls the initial backfill only \u2014 never a permanent monitoring filter."
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "name",
    "owner_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.owner_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}