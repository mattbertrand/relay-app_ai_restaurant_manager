{
  "name": "Conversation",
  "type": "object",
  "properties": {
    "restaurant_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "description": "Inbox lifecycle of the message itself: New, Reply recorded, or Archived. Separate from the underlying opportunity's lifecycle (New \u2192 In Progress \u2192 Resolved)."
    },
    "source": {
      "type": "string"
    },
    "opportunity_id": {
      "type": "string"
    },
    "gmail_thread_id": {
      "type": "string"
    },
    "gmail_message_id": {
      "type": "string"
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    },
    "analysis_status": {
      "type": "string",
      "enum": [
        "Not analyzed",
        "No opportunity",
        "Opportunity",
        "Attention",
        "Routine",
        "Administrative",
        "Spam",
        "Needs review"
      ]
    },
    "category": {
      "type": "string",
      "description": "What the email represents, e.g. reservation, job_application, general_customer_inquiry."
    },
    "analysis_version": {
      "type": "integer",
      "description": "The classifier rules version this message was last analyzed with \u2014 lets re-analysis skip conversations already classified by the current rules."
    },
    "last_analyzed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this conversation's analysis was last generated \u2014 used to detect that Restaurant Knowledge changed since the analysis."
    },
    "previous_analysis": {
      "type": "string",
      "description": "Snapshot of the analysis as it stood before the last re-analysis (classification, reasoning, draft) \u2014 preserved for audit so nothing is silently overwritten."
    },
    "intent": {
      "type": "string",
      "description": "Short phrase naming the customer's or sender's intent, e.g. 'Operating Hours', 'Reservation Request'."
    },
    "recommended_action": {
      "type": "string",
      "description": "Relay's recommended next action for this message \u2014 the specific step the manager should take, including a recommended handoff when one of the restaurant's response templates calls for it. Never an automatic action."
    },
    "draft_response": {
      "type": "string",
      "description": "The current reply draft for this message. Manager-controlled once edited \u2014 never silently overwritten by a newly generated draft."
    },
    "relay_draft": {
      "type": "string",
      "description": "Relay's own last generated draft, kept separate from draft_response so a manager's edits are always distinguishable from the generated version."
    },
    "draft_edited": {
      "type": "boolean",
      "default": false,
      "description": "True once the manager has edited the suggested reply. The draft is then manager-controlled content and is not silently regenerated."
    },
    "why_flagged": {
      "type": "string",
      "description": "Why Relay classified this message the way it did \u2014 why it matters and any conflict with verified restaurant facts."
    },
    "knowledge_used": {
      "type": "string",
      "description": "Which verified Restaurant Knowledge facts applied to this message, or a plain statement that the profile does not contain the needed information."
    },
    "reply_status": {
      "type": "string",
      "enum": [
        "Not replied",
        "Reply recorded"
      ],
      "default": "Not replied",
      "description": "Whether the manager has recorded a reply for this message. Recording a reply in Relay does not send an email to the customer."
    },
    "replied_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the reply was recorded in Relay."
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "restaurant_id",
    "customer_name",
    "subject",
    "status"
  ],
  "rls": {
    "read": {
      "data.restaurant_id": "{{user.data.restaurant_id}}"
    },
    "create": {
      "data.restaurant_id": "{{user.data.restaurant_id}}"
    },
    "update": {
      "data.restaurant_id": "{{user.data.restaurant_id}}"
    },
    "delete": {
      "data.restaurant_id": "{{user.data.restaurant_id}}"
    }
  }
}