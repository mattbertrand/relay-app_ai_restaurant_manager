{
  "name": "Conversation",
  "type": "object",
  "properties": {
    "restaurant_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "description": "Inbox lifecycle of the message itself: New, Reviewed, or Archived. Separate from the underlying opportunity's status."
    },
    "source": {
      "type": "string"
    },
    "opportunity_id": {
      "type": "string"
    },
    "gmail_thread_id": {
      "type": "string"
    },
    "gmail_message_id": {
      "type": "string"
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    },
    "analysis_status": {
      "type": "string",
      "enum": [
        "Not analyzed",
        "No opportunity",
        "Opportunity",
        "Attention",
        "Routine",
        "Spam",
        "Needs review"
      ]
    },
    "category": {
      "type": "string",
      "description": "What the email represents, e.g. reservation, job_application, general_customer_inquiry."
    },
    "intent": {
      "type": "string",
      "description": "Short phrase naming the customer's or sender's intent, e.g. 'Operating Hours', 'Reservation Request'."
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "restaurant_id",
    "customer_name",
    "subject",
    "status"
  ],
  "rls": {
    "read": {
      "data.restaurant_id": "{{user.data.restaurant_id}}"
    },
    "create": {
      "data.restaurant_id": "{{user.data.restaurant_id}}"
    },
    "update": {
      "data.restaurant_id": "{{user.data.restaurant_id}}"
    },
    "delete": {
      "data.restaurant_id": "{{user.data.restaurant_id}}"
    }
  }
}