{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "task_reminders",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "check_reminders": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "taskRemindersCheck"
          },
          "then": "end",
          "x-base44": {
            "title": "Check task reminders",
            "description": "Due reminders and overdue tasks"
          }
        }
      }
    ]
  },
  "name": "Task Reminders",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 15,
      "interval_unit": "minutes",
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Every 15 minutes, checks follow-up tasks for reminders that have come due and overdue tasks, and creates in-app notifications for the manager."
}